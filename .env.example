# Copy this file to .env and adjust the values: cp .env.example .env
# .env is git-ignored. Never commit real API keys.

# --- Application ---
APP_NAME=AutoMatch
# development | test | production
APP_ENV=development

# --- Paths (optional) ---
# Defaults: automatch.db and data/vehicles.csv in the project root.
# Uncomment only if you need a different location.
# DATABASE_URL=sqlite:///./automatch.db
# VEHICLES_CSV_PATH=data/vehicles.csv

# --- AI (optional) ---
# none   = rule/template fallbacks only (default, no API key needed)
# gemini = Google Gemini via a free Google AI Studio key
AI_PROVIDER=none
GEMINI_API_KEY=
